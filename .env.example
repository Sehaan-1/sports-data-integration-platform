# Copy to `.env` (git-ignored) to override the demo defaults.
# `docker compose up` works with no .env at all.

# --- database (compose-internal) ---
PGDATABASE=sdip
PGUSER=sdip
PGPASSWORD=sdip

# --- application secrets ---
# Leave blank for the local demo: the app logs a warning and falls back to a
# built-in development key. Any real deployment MUST set both.
# Generate one with PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SDIP_JWT_SECRET_B64=
SDIP_CREDENTIAL_KEY_B64=
